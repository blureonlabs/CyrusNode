# Apollo — local environment example.
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.

# --- Supabase Postgres ---
# Get from Supabase: Project Settings -> Database -> Connection string.
# Use the POOLED URL (port 6543, transaction mode) for the API and worker:
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) is needed by `cargo sqlx prepare` and migrations.
# Uncomment + use when running `apollo-cli migrate` if your pooler blocks DDL:
# DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECS=30

# --- Qdrant Cloud (free tier) ---
# Not used until Sprint 5 but set now so it stops being a TODO.
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6334
QDRANT_API_KEY=

# --- LLM providers ---
# Gemini (structured agents). Get at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Anthropic (Email Writer, WhatsApp Writer, Proposal Writer, Meeting Coach).
# Get at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Apollo runtime ---
PORT=8080
RUST_LOG=apollo=debug,tower_http=info,sqlx=warn
